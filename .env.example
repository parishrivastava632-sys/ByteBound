# ==============================================================
# OmniMedia AI Studio - Environment Variables Template
# ==============================================================

# Backend Configuration (Cloud Run / Local)
PORT=8080
NODE_ENV=development

# Gemini API Engine
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin Configuration (Backend)
# For local dev without cloud ADC, leave empty to enable simulated development mode
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=omnimedia-ai-studio

# Firebase Client Configuration (Frontend)
# Obtain these from Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY=AIzaSyDummyApiKeyForLocalDevelopment0123
VITE_FIREBASE_AUTH_DOMAIN=omnimedia-ai-studio.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=omnimedia-ai-studio
VITE_FIREBASE_STORAGE_BUCKET=omnimedia-ai-studio.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Frontend API Endpoint
VITE_API_URL=http://localhost:8080
